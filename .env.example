# ============================================================
# BodaERP — copy this to .env and fill in real values.
# .env itself is git-ignored and must never be committed.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# On your own computer (XAMPP/WAMP/MAMP) you need NOTHING here: BodaERP connects
# to MySQL on localhost as root and creates the database if it is missing.
# On the live server fill these four in (from your hosting panel) — that is the
# only database setup there is; the tables then build themselves on first visit.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Force the environment if auto-detection is ever wrong: live | local
# (set APP_ENV=live on the server so it can never overwrite the schema file)
APP_ENV=

# ── Automatic database updates ───────────────────────────────
# Local only: keep database/schema.snapshot.json in step with your local database
# (default on; set to 0 to pause). Commit that file with your code — the live
# server adds any new tables/fields from it by itself.
SCHEMA_AUTO_CAPTURE=1
# Extra tables the sync should ignore, comma separated (tmp_*, bak_*, backup_* are always ignored)
SCHEMA_IGNORE_TABLES=

# ── Login page ───────────────────────────────────────────────
# The demo-passwords box on the login page is shown on localhost only.
# Set to 1 on a live server ONLY for a short demo with sample data, then remove it.
SHOW_DEMO_LOGINS=

# ── Optional ─────────────────────────────────────────────────
# The URL folder is detected automatically (works in any folder name under htdocs, or at a
# domain root). Only set this if a proxy/alias makes it wrong. Use / for "domain root".
APP_BASE_URL=

# ── ioTec Pay ────────────────────────────────────────────────
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
IOTEC_GRANT_TYPE=client_credentials
IOTEC_TEST_WALLET_ID=
IOTEC_LIVE_WALLET_ID=
IOTEC_IPN_SECRET=
