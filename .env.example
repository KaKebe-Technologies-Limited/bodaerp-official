# BodaERP: copy this file to .env and fill in only what you need.
# .env is git-ignored and must never be committed.
# Order of precedence: real environment variables (hosting panel, Docker) > .env > built-in defaults.
# The defaults suit a stock XAMPP install, so on your own computer you usually need nothing here.

# Database
# XAMPP default: nothing to set (127.0.0.1, user root, no password, database "bodaerp", created automatically).
# Live server: fill these four in from your hosting panel; the tables build themselves on the first visit.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Environment
# live | local. Set APP_ENV=live on the server: it switches off developer helpers and never writes the schema file.
APP_ENV=
# 1 shows full PHP errors in the browser. Defaults to on locally, off on a live server. Never 1 on a live server.
APP_DEBUG=
# Public address used in emails, QR codes and the sitemap, e.g. https://bodaerp.example.com (no trailing slash).
# Leave empty to detect it from the request. Set it on a live server behind a proxy or CDN.
APP_URL=
# URL folder, detected automatically (any folder name under htdocs, or a domain root). Only set it if a proxy or
# alias makes the detection wrong. Use / for "domain root".
APP_BASE_URL=

# Files
# Where uploads (rider photos, media library) and runtime files (logs, mail log) are kept.
# Defaults: <project>/uploads and <project>/storage. Both are outside git; the web server must be able to write to them.
UPLOAD_PATH=
STORAGE_PATH=

# Email
# Without SMTP_HOST every email (password reset, receipts, contact form) is written to storage/mail/ and listed in
# Super Admin → Email Templates → Sent log, so all flows still work on XAMPP. Two-step sign-in stays off without SMTP.
# Hostinger: SMTP_HOST=smtp.hostinger.com SMTP_PORT=465 SMTP_SECURE=ssl, user/password of a mailbox you created.
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, port 587) | ssl (port 465) | none (local mail catchers only)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# Sender address; must be a mailbox on your domain for most providers.
MAIL_FROM=

# Automatic database updates
# Local only: keep database/schema.snapshot.json in step with your local database (default on; 0 pauses it).
SCHEMA_AUTO_CAPTURE=1
# Extra tables the sync should ignore, comma separated (tmp_*, bak_*, backup_* are always ignored)
SCHEMA_IGNORE_TABLES=

# Developer helpers
# Demo passwords on the sign-in page show on your own computer only. 1 forces them on (the Docker dev stack does this).
# Never set this on a live server.
SHOW_DEMO_LOGINS=

# ioTec Pay (mobile money)
# test (default) charges the test wallet; live charges real money. Switch to live only after an end-to-end test.
IOTEC_MODE=test
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
IOTEC_GRANT_TYPE=client_credentials
IOTEC_TEST_WALLET_ID=
IOTEC_LIVE_WALLET_ID=
# Shared secret ioTec sends with each payment callback. Without it every callback is rejected.
IOTEC_IPN_SECRET=
# Optional: the one request header ioTec puts the secret in (e.g. Authorization). Empty = any header.
IOTEC_IPN_HEADER=

# SMS (EgoSMS, egosms.co)
# Receipts, renewal reminders, reminders pressed by chairpersons, and sign-in codes by text message.
# Without a username and password every SMS is written to storage/sms/ and listed in Super Admin → SMS, so nothing
# reaches a real phone during development.
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
# Sender ID approved on your EgoSMS account (at most 11 characters).
EGOSMS_SENDER=
# sandbox (default) | live. Sandbox needs a separate sandbox account from EgoSMS.
EGOSMS_MODE=sandbox

# USSD renewal
# The USSD provider calls <site>/ussd.php?token=<USSD_TOKEN> (form fields sessionId, phoneNumber, text).
# Without a token every USSD request is refused. Generate one: php -r "echo bin2hex(random_bytes(24));"
USSD_TOKEN=
# Optional: comma-separated IP addresses the provider calls from. Empty = any address with the right token.
USSD_ALLOWED_IPS=

# Tests (developer machines only)
# Address the test scripts open; default http://localhost/<folder name>.
TEST_BASE_URL=
# Mailpit API, so tests can read emails (set by docker-compose.yml).
MAILPIT_API=

# Automatic backups (storage/backups). They hold rider data, so set a key on any real server:
#   php -r "echo bin2hex(random_bytes(32));"
# Keep the key somewhere other than this server. Without it an encrypted backup cannot be restored by anyone.
BACKUP_KEY=
BACKUP_KEEP_DAYS=14
