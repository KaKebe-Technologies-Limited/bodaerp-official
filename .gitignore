# ============================================================
# BodaERP: files git must not track
# ============================================================

# ----- Sensitive config (tracked once, then ignored) -----
# After the first commit of database.php with live credentials,
# run: git update-index --assume-unchanged config/database.php
# This keeps the file on the server without overwriting it on pull.
config/database.php

# ----- Diagnostic / debug files (never commit these) -----
diag.php
dbcheck.php

# ----- Uploads (user-generated content, not source code) -----
uploads/

# ----- PHP / OS junk -----
.DS_Store
Thumbs.db
*.log
*.bak
*.swp
*.tmp

# ----- IDE / editor files -----
.vscode/settings.json
.idea/
*.sublime-workspace

# ----- Environment files -----
.env
.env.*
database/u850523537_BodaERP26.sql

# ioTec IPN debug log written by ipn_handler.php
ipn_logs.txt
!.env.example

# PHP + MySQL + plain JavaScript only: no Node/Composer tooling in this project
node_modules/
vendor/
package.json
package-lock.json
composer.json
composer.lock

# Runtime data written by the app (logs, mail log when there is no SMTP)
storage/

# Browser test screenshots
.playwright-mcp/

# Local assistant and editor tooling: never deployed
.claude/
