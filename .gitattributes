# Store every text file with LF line endings, so Windows (XAMPP) and Linux checkouts never produce noisy diffs.
* text=auto eol=lf

# Windows-only helper scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
